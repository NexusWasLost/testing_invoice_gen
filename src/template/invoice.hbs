<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Invoice - {{invoiceId}}</title>
    <style>
        @page {
            size: A4;
            margin: 20mm;
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #1e293b;
            margin: 0;
            padding: 40px;
            background-color: #f1f5f9;
        }

        .invoice-card {
            max-width: 650px;
            margin: 0 auto;
            padding: 40px;
            background-color: #fff;
            border-radius: 10px;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.06);
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            border-bottom: 2px solid #e2e8f0;
            padding-bottom: 24px;
            margin-bottom: 28px;
        }

        .company-name {
            font-size: 22px;
            font-weight: 700;
            color: #2563eb;
            letter-spacing: 0.5px;
        }

        .invoice-title {
            font-size: 13px;
            font-weight: 600;
            color: #94a3b8;
            letter-spacing: 2px;
            text-align: right;
        }

        .invoice-id {
            font-size: 18px;
            font-weight: 700;
            color: #1e293b;
            margin-top: 4px;
        }

        .meta-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 28px;
            gap: 24px;
        }

        .label {
            color: #94a3b8;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 4px;
        }

        .bill-to .name {
            font-size: 16px;
            font-weight: 600;
        }

        .bill-to .email {
            font-size: 13px;
            color: #64748b;
            margin-top: 2px;
        }

        .order-meta {
            text-align: right;
            font-size: 12px;
            color: #64748b;
        }

        .order-meta .rzp-id {
            font-family: monospace;
            font-size: 11px;
            color: #94a3b8;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 24px;
        }

        th {
            text-align: left;
            padding: 10px 8px;
            background-color: #f8fafc;
            color: #64748b;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            border-bottom: 1px solid #e2e8f0;
        }

        td {
            padding: 12px 8px;
            border-bottom: 1px solid #f1f5f9;
            font-size: 14px;
        }

        .text-right {
            text-align: right;
        }

        .sku-cell {
            display: block;
            font-size: 11px;
            color: #94a3b8;
            font-family: monospace;
            margin-top: 2px;
        }

        .tax-cell {
            color: #64748b;
            font-size: 13px;
        }

        .totals {
            display: flex;
            justify-content: flex-end;
        }

        .totals-box {
            width: 55%;
        }

        .totals-row {
            display: flex;
            justify-content: space-between;
            font-size: 13px;
            color: #64748b;
            padding: 6px 0;
        }

        .totals-row.grand {
            border-top: 2px solid #2563eb;
            margin-top: 8px;
            padding-top: 12px;
            font-size: 18px;
            font-weight: 700;
            color: #1e293b;
        }

        .footer-note {
            margin-top: 32px;
            padding-top: 16px;
            border-top: 1px solid #f1f5f9;
            font-size: 11px;
            color: #94a3b8;
            text-align: center;
        }

        .download-bar {
            max-width: 650px;
            margin: 16px auto 0 auto;
            text-align: right;
        }

        .download-button {
            background-color: #2563eb;
            color: #fff;
            border: none;
            padding: 10px 20px;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
        }

        .download-button:hover {
            background-color: #1d4ed8;
        }

        @media print {
            body {
                background-color: #fff;
                padding: 0;
            }

            .download-bar {
                display: none;
            }

            .invoice-card {
                box-shadow: none;
                max-width: 100%;
                margin: 0;
            }

            * {
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
        }
    </style>
</head>

<body>

    <div class="invoice-card">
        <div class="header">
            <div class="company-name">Pixel Store</div>
            <div class="invoice-title">
                INVOICE
                <div class="invoice-id">{{invoiceId}}</div>
            </div>
        </div>

        <div class="meta-row">
            <div class="bill-to">
                <p class="label">Billed To</p>
                <p class="name">{{name}}</p>
                {{#if email}}<p class="email">{{email}}</p>{{/if}}
            </div>

            <div class="order-meta">
                <p class="label">Order Reference</p>
                <p class="rzp-id">{{rzp_order_id}}</p>
            </div>
        </div>

        <table>
            <thead>
                <tr>
                    <th>Item</th>
                    <th class="text-right">Qty</th>
                    <th class="text-right">Price</th>
                    <th class="text-right">Tax</th>
                    <th class="text-right">Amount</th>
                </tr>
            </thead>
            <tbody>
                {{#each items}}
                <tr>
                    <td>
                        {{this.name}}
                        {{#if this.SKU}}<span class="sku-cell">{{this.SKU}}</span>{{/if}}
                    </td>
                    <td class="text-right">{{this.quantity}}</td>
                    <td class="text-right">₹{{this.price}}</td>
                    <td class="text-right tax-cell">{{this.taxApplicable}}%</td>
                    <td class="text-right">₹{{lineTotal}}</td>
                </tr>
                {{/each}}
            </tbody>
        </table>

        <div class="totals">
            <div class="totals-box">
                <div class="totals-row">
                    <span>Subtotal</span>
                    <span>₹{{sub_total}}</span>
                </div>
                <div class="totals-row grand">
                    <span>Total Due</span>
                    <span>₹{{total}}</span>
                </div>
            </div>
        </div>

        <div class="footer-note">
            This is a computer-generated invoice and does not require a signature.
        </div>
    </div>

    <div class="download-bar">
        <button class="download-button" onclick="window.print()">Download Invoice</button>
    </div>

    <script>
        window.oncontextmenu = function () {
            return false;
        };

        document.addEventListener("keydown", function (event) {
            if (event.key === "F12") {
                event.preventDefault();
            }

            if (event.ctrlKey && event.shiftKey && (event.key === "I" || event.key === "J")) {
                event.preventDefault();
            }
        }, false);

        const params = new URLSearchParams(window.location.search);

        if (params.get("download") === "true") {
            window.addEventListener("load", function () {
                window.print();
            });
        }
    </script>

</body>

</html>
